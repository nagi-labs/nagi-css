{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nagi Scoped Role Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scopes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "scopes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/scope"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "roles"
          ]
        },
        {
          "required": [
            "purposes"
          ]
        }
      ],
      "properties": {
        "purposes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/roleName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/purpose"
          }
        },
        "roles": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/roleName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/role"
          }
        }
      }
    },
    "roleName": {
      "type": "string",
      "pattern": "^(?!root$)[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "required": {
          "type": "boolean",
          "deprecated": true,
          "description": "Compatibility alias for declaration. Prefer declaration."
        },
        "role": {
          "$ref": "#/$defs/purposeTarget",
          "deprecated": true,
          "description": "Compatibility alias for on. Specify only one of on and role."
        },
        "on": {
          "$ref": "#/$defs/purposeTarget"
        },
        "layer": {
          "enum": [
            "contract",
            "implementation"
          ],
          "default": "implementation"
        },
        "declaration": {
          "enum": [
            "required",
            "optional"
          ],
          "default": "optional"
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "on",
              "role"
            ]
          }
        },
        {
          "if": {
            "required": [
              "required"
            ],
            "properties": {
              "required": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "declaration": {
                "const": "required"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "required"
            ],
            "properties": {
              "required": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "declaration": {
                "const": "optional"
              }
            }
          }
        }
      ]
    },
    "purposeTarget": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "element": {
          "$ref": "#/$defs/name"
        },
        "aria": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean",
          "deprecated": true,
          "description": "Compatibility alias for declaration. Prefer declaration."
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "native": {
          "type": "boolean",
          "default": false
        },
        "layer": {
          "enum": [
            "contract",
            "implementation"
          ],
          "default": "implementation"
        },
        "declaration": {
          "enum": [
            "required",
            "optional"
          ],
          "default": "optional"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "required"
            ],
            "properties": {
              "required": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "declaration": {
                "const": "required"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "required"
            ],
            "properties": {
              "required": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "declaration": {
                "const": "optional"
              }
            }
          }
        }
      ]
    }
  }
}
